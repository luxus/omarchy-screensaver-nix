#!/usr/bin/env bash
# Toggle idle-screensaver availability. Presence of the off flag means disabled.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-screensaver"
mkdir -p "$STATE_DIR"
FLAG="$STATE_DIR/off"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a omarchy-screensaver -i screensaver "$@"
  fi
}

case "${1:-toggle}" in
on | enable)
  rm -f "$FLAG"
  notify "Screensaver enabled"
  echo enabled
  ;;
off | disable)
  touch "$FLAG"
  notify "Screensaver disabled"
  echo disabled
  ;;
status)
  if [[ -f $FLAG ]]; then
    printf '{"enabled":false}\n'
  else
    printf '{"enabled":true}\n'
  fi
  ;;
toggle | *)
  if [[ -f $FLAG ]]; then
    rm -f "$FLAG"
    notify "Screensaver enabled"
    echo enabled
  else
    touch "$FLAG"
    notify "Screensaver disabled"
    echo disabled
  fi
  ;;
esac
