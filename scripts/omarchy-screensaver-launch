#!/usr/bin/env bash
# Launch one fullscreen screensaver terminal per monitor.
# KWin (Plasma / Noctalia) is the default path; Hyprland is still supported.

set -u

CONFIG="${OMARCHY_SCREENSAVER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-screensaver/config}"
# shellcheck disable=SC1090
[[ -f ${CONFIG} ]] && source "${CONFIG}"

WINDOW_CLASS="${WINDOW_CLASS:-org.omarchy.screensaver}"
TERMINAL="${TERMINAL:-auto}"
COMPOSITOR="${COMPOSITOR:-auto}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-screensaver"
SHARE_DIR="${SHARE_DIR:-}"
FONT_SIZE="${FONT_SIZE:-18}"
FORCE=0
[[ ${1:-} == force ]] && FORCE=1

class_pattern() {
  local c="$WINDOW_CLASS"
  printf '%s' "[${c:0:1}]${c:1}"
}

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a omarchy-screensaver "$@"
  fi
}

hide_desktop_chrome() {
  command -v noctalia >/dev/null 2>&1 || return 0
  noctalia msg bar-hide >/dev/null 2>&1 || true
  noctalia msg dock-hide >/dev/null 2>&1 || true
}

show_desktop_chrome() {
  command -v noctalia >/dev/null 2>&1 || return 0
  noctalia msg bar-show >/dev/null 2>&1 || true
  noctalia msg dock-show >/dev/null 2>&1 || true
}

# Already running
pgrep -f "$(class_pattern)" >/dev/null 2>&1 && exit 0

# Idle launch is skipped when the user toggled the screensaver off
if [[ $FORCE -ne 1 && -f $STATE_DIR/off ]]; then
  exit 1
fi

resolve_terminal() {
  local t="$TERMINAL"
  if [[ $t != auto ]]; then
    printf '%s' "$t"
    return
  fi
  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    t=$(xdg-terminal-exec --print-id 2>/dev/null || true)
  fi
  t="${t:-${TERM_PROGRAM:-${TERMINAL_EMULATOR:-}}}"
  case $t in
  *[Aa]lacritty*) printf 'alacritty' ;;
  *[Gg]hostty*) printf 'ghostty' ;;
  *[Ff]oot*) printf 'foot' ;;
  *[Kk]itty*) printf 'kitty' ;;
  *)
    for cand in kitty ghostty foot alacritty; do
      if command -v "$cand" >/dev/null 2>&1; then
        printf '%s' "$cand"
        return
      fi
    done
    printf ''
    ;;
  esac
}

detect_compositor() {
  local c="$COMPOSITOR"
  case $c in
  kwin | hyprland)
    printf '%s' "$c"
    return
    ;;
  esac
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
    printf 'hyprland'
    return
  fi
  if [[ ${XDG_CURRENT_DESKTOP:-} == *KDE* ]] ||
    [[ ${XDG_SESSION_DESKTOP:-} == *plasma* ]] ||
    [[ ${KDE_FULL_SESSION:-} == true ]] ||
    pgrep -x kwin_wayland >/dev/null 2>&1 ||
    pgrep -x kwin_x11 >/dev/null 2>&1; then
    printf 'kwin'
    return
  fi
  printf 'none'
}

terminal=$(resolve_terminal)

if [[ -z $terminal ]]; then
  notify "Screensaver needs Alacritty, Foot, Ghostty, or Kitty"
  echo "omarchy-screensaver-launch: no supported terminal found" >&2
  exit 1
fi

inner="${SCREENSAVER_BIN:-omarchy-screensaver}"
compositor=$(detect_compositor)

term_config() {
  local name="$1"
  local user="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-screensaver/terminals/$name"
  local share=""
  [[ -n $SHARE_DIR && -e $SHARE_DIR/terminals/$name ]] && share="$SHARE_DIR/terminals/$name"
  if [[ -e $user ]]; then
    printf '%s' "$user"
    return
  fi
  if [[ -n $share ]]; then
    mkdir -p "$(dirname "$user")"
    # Writable copy so Noctalia user templates can replace it on the next palette apply.
    if cp -n "$share" "$user" 2>/dev/null; then
      printf '%s' "$user"
      return
    fi
    printf '%s' "$share"
  fi
}

# TERM_CMD is filled by build_term_cmd. Extra leading args (e.g. kitty --detach)
# can be passed as $1..
build_term_cmd() {
  TERM_CMD=()
  local extra=()
  if [[ ${1:-} == detach ]]; then
    extra=(detach)
  fi
  local cfg
  case $terminal in
  alacritty)
    cfg=$(term_config alacritty.toml)
    TERM_CMD=(alacritty --class="$WINDOW_CLASS")
    [[ -n $cfg ]] && TERM_CMD+=(--config-file "$cfg")
    TERM_CMD+=(-e "$inner")
    ;;
  ghostty)
    cfg=$(term_config ghostty)
    TERM_CMD=(ghostty --class="$WINDOW_CLASS" --gtk-single-instance=false --cursor-opacity=0)
    [[ -n $cfg ]] && TERM_CMD+=(--config-file="$cfg")
    TERM_CMD+=(--font-size="$FONT_SIZE" -e "$inner")
    ;;
  foot)
    cfg=$(term_config foot.ini)
    TERM_CMD=(foot --app-id="$WINDOW_CLASS")
    [[ -n $cfg ]] && TERM_CMD+=(--config="$cfg")
    TERM_CMD+=(-e "$inner")
    ;;
  kitty)
    cfg=$(term_config kitty.conf)
    TERM_CMD=(kitty)
    [[ ${extra[0]:-} == detach ]] && TERM_CMD+=(--detach)
    [[ -n $cfg ]] && TERM_CMD+=(--config "$cfg")
    TERM_CMD+=(--class="$WINDOW_CLASS" --start-as-fullscreen
      --override font_size="$FONT_SIZE"
      --override window_padding_width=0
      --override hide_window_decorations=yes
      --override confirm_os_window_close=0
      --override remember_window_size=no
      --override allow_remote_control=no
      -e "$inner")
    ;;
  *)
    notify "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
    exit 1
    ;;
  esac
}

spawn_detached() {
  build_term_cmd detach
  local -a envcmd=(env)
  if [[ -n ${SHARE_DIR:-} && -d $SHARE_DIR/icons ]]; then
    envcmd+=(
      XCURSOR_THEME=omarchy-ss-blank
      XCURSOR_PATH="$SHARE_DIR/icons${XCURSOR_PATH:+:$XCURSOR_PATH}"
    )
  fi
  if [[ $terminal == kitty ]]; then
    "${envcmd[@]}" "${TERM_CMD[@]}"
  else
    mkdir -p "$STATE_DIR"
    nohup "${envcmd[@]}" "${TERM_CMD[@]}" >>"$STATE_DIR/last-launch.log" 2>&1 &
    disown $! 2>/dev/null || true
  fi
}

# --- Hyprland --------------------------------------------------------------

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 \
    || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"
  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 \
    || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

launch_hyprland() {
  hide_desktop_chrome
  local SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"
  local events=""
  if [[ -S $SOCKET ]] && command -v socat >/dev/null 2>&1; then
    exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET")
  fi

  wait_for_screensaver_window() {
    [[ -z ${events:-} ]] && sleep 0.25 && return 0
    local line deadline=$((SECONDS + 5))
    while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
      [[ $line == openwindow\>\>*,${WINDOW_CLASS},* ]] && return 0
    done
    return 0
  }

  local focused
  focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused==true) | .name' | head -n1)
  build_term_cmd

  local m
  for m in $(hyprctl monitors -j | jq -r '.[].name'); do
    hypr_focus_monitor "$m"
    hypr_exec "${TERM_CMD[@]}"
    wait_for_screensaver_window
  done

  [[ -n $focused ]] && hypr_focus_monitor "$focused"
}

# --- KWin / Plasma ---------------------------------------------------------

kwin_outputs() {
  if ! command -v kscreen-doctor >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    printf 'primary\n'
    return
  fi
  local json names
  json=$(kscreen-doctor -j 2>/dev/null || true)
  if [[ -z $json ]]; then
    printf 'primary\n'
    return
  fi
  names=$(jq -r '
    (if type == "object" and has("outputs") then .outputs[]
     elif type == "array" then .[]
     else empty end)
    | select((.enabled // true) and (.connected // true))
    | (.name // (.id|tostring) // "output")
  ' <<<"$json" 2>/dev/null || true)
  if [[ -z $names ]]; then
    printf 'primary\n'
  else
    printf '%s\n' "$names"
  fi
}

kwin_qdbus() {
  if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 "$@"
  elif command -v qdbus >/dev/null 2>&1; then
    qdbus "$@"
  else
    return 1
  fi
}

# Ghostty/GTK cannot pick a Wayland output. After spawn, assign each window
# to a live KWin screen (workspace.screens — current monitors, not a snapshot).
kwin_place_on_outputs() {
  kwin_qdbus org.kde.KWin /Scripting >/dev/null 2>&1 || return 0
  local js name num
  js=$(mktemp "${TMPDIR:-/tmp}/omarchy-ss.XXXXXX.js")
  name="omarchy-ss-$$"
  cat >"$js" <<EOF
const cls = $(jq -n --arg c "$WINDOW_CLASS" '$c');
const screens = workspace.screens;
const wins = workspace.windowList().filter((w) => String(w.resourceClass || "") === cls);
for (let i = 0; i < screens.length; i++) {
  if (!wins[i]) break;
  if (typeof workspace.sendClientToScreen === "function") workspace.sendClientToScreen(wins[i], screens[i]);
  else wins[i].output = screens[i];
  wins[i].fullScreen = true;
  wins[i].keepAbove = true;
  wins[i].onAllDesktops = true;
  wins[i].skipTaskbar = true;
  wins[i].noBorder = true;
}
EOF
  num=$(kwin_qdbus org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$js" "$name" 2>/dev/null || true)
  if [[ -n ${num:-} && $num != *-1 ]]; then
    kwin_qdbus org.kde.KWin /Scripting/Script"${num}" org.kde.kwin.Script.run >/dev/null 2>&1 || true
    kwin_qdbus org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "$name" >/dev/null 2>&1 || true
  fi
  rm -f "$js"
}

launch_kwin() {
  local outputs out
  mapfile -t outputs < <(kwin_outputs)
  ((${#outputs[@]})) || outputs=(primary)
  hide_desktop_chrome
  for out in "${outputs[@]}"; do
    spawn_detached
    sleep 0.15
  done
  local _try
  for _try in 1 2 3 4 5; do
    kwin_place_on_outputs
    sleep 0.2
  done
  if ! pgrep -f "$(class_pattern)" >/dev/null 2>&1; then
    show_desktop_chrome
  fi
  : "$out"
}

# --- dispatch --------------------------------------------------------------

case $compositor in
hyprland)
  launch_hyprland
  ;;
kwin)
  launch_kwin
  ;;
*)
  # Nested in an existing terminal (ssh, tty, unknown compositor).
  exec "$inner"
  ;;
esac
